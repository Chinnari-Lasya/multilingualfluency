# Copy to .env. Point GEC_HOME at any large-disk location OUTSIDE the repo/OneDrive.
GEC_HOME=D:/gec-data
HF_HOME=D:/gec-data/hf_cache
GEC_DEVICE=auto              # auto | cpu | cuda  (CPU fallback always works)
GEC_DATABASE_URL=postgresql+psycopg://gec:gec@localhost:5432/gec
GEC_JWT_SECRET=change-me
# LLM is OPTIONAL. Default 'none' = rule/template explanations only. No paid API assumed.
GEC_LLM_PROVIDER=none        # none | openai_compatible (e.g. a local Ollama/vLLM server)
GEC_LLM_BASE_URL=
GEC_LLM_MODEL=
GEC_LLM_API_KEY=
